FIREBASE_PROJECT_ID=serviceproviderapp01

# Option 1: recommended locally. Download a Firebase Admin SDK service account
# JSON file from Firebase Console and point to it.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option 2: useful for hosting providers. Paste the full service account JSON
# as a single environment variable. Do not commit real credentials.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional local emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# AI allocation agent (optional — uses heuristic scoring when unset)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
